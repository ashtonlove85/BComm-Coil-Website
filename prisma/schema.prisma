generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  name       String?
  email      String?  @unique
  image      String?
  isPremium  Boolean  @default(false)
  vibes      String[]
  savedSpots String[]
  creators   Creator?
  reviews    Review[]
  lists      List[]
  accounts   Account[]
  sessions   Session[]
}

model Spot {
  id           String   @id @default(cuid())
  name         String
  category     String
  city         String
  neighborhood String
  description  String
  photos       String[]
  lat          Float
  lng          Float
  hours        String
  tags         String[]
  creatorId    String?
  creator      Creator? @relation(fields: [creatorId], references: [id])
  reviews      Review[]
}

model City {
  id         String @id @default(cuid())
  name       String
  country    String
  slug       String @unique
  coverPhoto String
  featured   Boolean @default(false)
}

model Creator {
  id        String @id @default(cuid())
  userId    String @unique
  bio       String
  spotCount Int    @default(0)
  following Int    @default(0)
  user      User   @relation(fields: [userId], references: [id])
  spots     Spot[]
}

model Review {
  id      String @id @default(cuid())
  spotId  String
  userId  String
  content String
  rating  Int
  spot    Spot   @relation(fields: [spotId], references: [id])
  user    User   @relation(fields: [userId], references: [id])
}

model List {
  id      String   @id @default(cuid())
  userId  String
  name    String
  spotIds String[]
  user    User     @relation(fields: [userId], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
